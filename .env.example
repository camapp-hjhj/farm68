# Điền các giá trị này trong Netlify: Site configuration → Environment variables

# Lấy từ Google Cloud Console → APIs & Services → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự, dùng để ký phiên đăng nhập
AUTH_SECRET=

# Email Google của người quản trị gốc (cách nhau bằng dấu phẩy)
OWNER_EMAILS=

# Không bắt buộc: địa chỉ web cố định, ví dụ https://farm68.netlify.app
SITE_URL=
